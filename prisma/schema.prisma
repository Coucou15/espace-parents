// Schéma Prisma pour l'application Espace Parents
// Voir : https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Approche key/value : chaque ressource (annonces, menu, albums, etc.)
// est stockée comme un objet JSON sérialisé sous une clé unique.
// Permet de reprendre la même structure que useSharedStore sans
// avoir à modéliser chaque entité finement (à faire en étape 2).
model Store {
  name      String   @id
  value     String   // JSON sérialisé
  updatedAt DateTime @updatedAt
}

// Abonnements Web Push : un par navigateur+utilisateur.
// `endpoint` est unique et fourni par le service de push (Google/Mozilla).
// `p256dh` et `auth` sont les clés permettant de chiffrer le payload.
model PushSubscription {
  id          String   @id @default(cuid())
  endpoint    String   @unique
  p256dh      String
  auth        String
  userEmail   String?  // pour cibler un parent précis (facultatif)
  userAgent   String?
  createdAt   DateTime @default(now())
}

// Utilisateurs : parents + personnels admin/enseignants/cantine.
// Le rôle détermine les permissions.
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  prenom          String
  nom             String
  motDePasseHash  String   // bcrypt
  role            String   // "parent" | "admin-ecole" | "super-admin" | "enseignant" | "cantine"
  telephone       String?
  codeAcces       String?  // 6 chiffres, pour les parents uniquement
  matiere         String?  // pour les enseignants (ex: "Mathématiques")
  statut          String   @default("actif") // "actif" | "suspendu"
  createdAt       DateTime @default(now())
  enfants         Enfant[]
  sessions        Session[]
  resetTokens     PasswordResetToken[]
}

// Créneaux de disponibilité d'un enseignant pour les rendez-vous parents.
// Le créneau peut être réservé par un parent ; quand pris=true, rdvId pointe
// vers le RendezVous correspondant.
model CreneauDisponible {
  id           String   @id @default(cuid())
  enseignantId String
  dateHeure    DateTime
  duree        Int      @default(15) // minutes
  pris         Boolean  @default(false)
  rdvId        String?  // si réservé, ID du RendezVous
}

// Rendez-vous pris par un parent avec un enseignant.
model RendezVous {
  id           String   @id @default(cuid())
  parentId     String
  enseignantId String
  enfantId     String?  // optionnel : à quel enfant le RDV concerne
  creneauId    String?  // créneau d'origine, pour le libérer en cas d'annulation
  dateHeure    DateTime
  duree        Int      @default(15)
  motif        String?
  statut       String   @default("confirme") // "confirme" | "annule"
  createdAt    DateTime @default(now())
}

// Enfants rattachés à un parent.
model Enfant {
  id        String @id @default(cuid())
  prenom    String
  nom       String
  palierId  String
  niveauId  String
  section   String
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Sessions : un token (= id) stocké dans un cookie HTTP-only.
// Expirent automatiquement après 30 jours.
model Session {
  id        String   @id // identifiant aléatoire = valeur du cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires   DateTime
  createdAt DateTime @default(now())
}

// Jeton de réinitialisation de mot de passe.
// Créé quand le parent clique "mot de passe oublié", expire après 1h,
// supprimé après usage.
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique // valeur dans l'URL du lien d'e-mail
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires   DateTime
  createdAt DateTime @default(now())
}

// Messages envoyés par les parents via la page "Nous contacter".
// L'administration les voit dans /admin/messages.
model MessageContact {
  id            String   @id @default(cuid())
  parentId      String?  // si parent connecté ; sinon message anonyme (pas notre cas pour l'instant)
  parentPrenom  String
  parentNom     String
  email         String
  sujet         String
  message       String
  traite        Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// Demande d'inscription en attente de validation par l'administration.
// Le mot de passe est déjà haché à la soumission ; à la validation, on
// transfère les données dans User et on supprime la demande.
model DemandeInscription {
  id             String   @id @default(cuid())
  parentPrenom   String
  parentNom      String
  email          String   @unique
  telephone      String?
  motDePasseHash String
  enfants        String   // JSON sérialisé : [{prenom, nom, palierId, niveauId, section}]
  createdAt      DateTime @default(now())
}
